# ---------------------------------------------------------------------------
# Configurazione dello stack Docker.
#
#   cp .env.docker.example .env.docker
#   # compila i valori qui sotto, poi:
#   docker compose --env-file .env.docker up -d --build
#
# E' un file separato da .env di proposito: .env serve all'installazione di
# sviluppo, questo al contenitore, e i valori non sono gli stessi (il database
# qui si chiama "db", non "localhost"). Non finisce in git.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PORTE PUBBLICATE
#   Le uniche due porte esposte dallo stack. Il database non e' pubblicato.
#   Lasciale alte se la macchina ha gia' qualcosa sulla 80 e sulla 443: 8443
#   e 8080 non richiedono privilegi e non danno conflitti con altri stack.
#   Verifica che siano libere con:  bash docker/controlla-porte.sh
#   Con Let's Encrypt devono invece essere esattamente 443 e 80.
# ---------------------------------------------------------------------------
HTTPS_PORT="8443"
HTTP_PORT="8080"

# ---------------------------------------------------------------------------
# COME SI RAGGIUNGE IL PORTALE
#   INDIRIZZO  host o IP con cui apri il portale dal browser. Finisce nel
#              certificato: se non combacia, il browser rifiuta a prescindere.
#   AUTH_URL   lo stesso indirizzo completo di schema e porta. Deve coincidere
#              con quello che scrivi nella barra degli indirizzi, altrimenti
#              l'accesso rimanda altrove e il login gira a vuoto.
# ---------------------------------------------------------------------------
INDIRIZZO="10.254.254.90"
AUTH_URL="https://10.254.254.90:8443"

# ---------------------------------------------------------------------------
# HTTPS
#   Caddyfile.interno       certificato autofirmato, va con qualsiasi IP o
#                           nome di rete interna. Il browser avvisa una volta
#                           che non riconosce l'emittente: la connessione e'
#                           comunque cifrata.
#   Caddyfile.letsencrypt   certificato vero e nessun avviso, ma servono un
#                           dominio pubblico che risolva a questa macchina e
#                           le porte 443 e 80 raggiungibili da internet.
#                           In quel caso compila DOMINIO ed EMAIL_AMMINISTRATORE,
#                           metti HTTPS_PORT=443 e HTTP_PORT=80, e AUTH_URL
#                           senza porta: https://portale.esempio.it
# ---------------------------------------------------------------------------
CADDYFILE="./docker/Caddyfile.interno"
DOMINIO=""
EMAIL_AMMINISTRATORE=""

# ---------------------------------------------------------------------------
# DATABASE
#   Resta dentro la rete del compose: non e' raggiungibile da fuori, e la
#   password serve solo ai contenitori fra loro. Generala comunque lunga:
#     openssl rand -hex 24
# ---------------------------------------------------------------------------
POSTGRES_USER="portale"
POSTGRES_PASSWORD=""
POSTGRES_DB="portale_talenti"

# ---------------------------------------------------------------------------
# SESSIONI
#   Firma i token di sessione. Generala con:  openssl rand -base64 32
#   Cambiarla invalida tutte le sessioni aperte.
# ---------------------------------------------------------------------------
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# PRIMO AMMINISTRATORE
#   Chi si registra con una di queste email diventa ADMIN al primo accesso.
#   Compilala PRIMA del primo avvio: e' il modo previsto per entrare, dato
#   che gli utenti dimostrativi qui non vengono creati.
# ---------------------------------------------------------------------------
ADMIN_EMAILS="tua.email@esempio.it"

# Utenti dimostrativi con password nota: false su un portale pubblicato.
# Mettilo a true solo per una prova usa e getta.
SEED_DEMO_USERS="false"

# ---------------------------------------------------------------------------
# Opzionali
# ---------------------------------------------------------------------------
NEXT_PUBLIC_QUESTION_TIMER_SECONDS="20"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
