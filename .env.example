# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portale_talenti?schema=public"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
#   Genera il segreto con:  openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="cambia-questo-valore-con-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Google OAuth (console.cloud.google.com > API e servizi > Credenziali)
#   Redirect URI autorizzato: http://localhost:3000/api/auth/callback/google
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Origini autorizzate del server di sviluppo
#   Lascia vuoto se non sai di averne bisogno: da vuoto il server serve le
#   risorse interne a qualunque origine, e aprire l'app dall'IP di rete
#   funziona gia'. Valorizzarlo ATTIVA il controllo: da quel momento ogni host
#   non elencato riceve 403. Serve dietro proxy o dentro un container.
#   Elenco separato da virgole, host soli: niente schema e niente porta.
#   In produzione (next build + next start) non ha effetto.
# ---------------------------------------------------------------------------
DEV_ORIGINS=""

# ---------------------------------------------------------------------------
# Configurazione questionario
# ---------------------------------------------------------------------------
NEXT_PUBLIC_QUESTION_TIMER_SECONDS="20"

# Email che ricevono automaticamente il ruolo ADMIN al primo accesso
# (elenco separato da virgole)
ADMIN_EMAILS="admin@portaletalenti.it"
