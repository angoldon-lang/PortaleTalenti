// ---------------------------------------------------------------------------
// Portale Talenti — schema dati
// PostgreSQL + Prisma
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// MODULO 1 — Autenticazione, utenti e ruoli
// ===========================================================================

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  /// Hash bcrypt: null per gli utenti che accedono solo via Google OAuth.
  passwordHash  String?
  emailVerified DateTime?
  role          Role      @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Ruolo organizzativo (collaboratore, manager, leader…): decide quali
  /// questionari la persona vede. È cosa diversa da `role`, che governa i
  /// permessi nel portale.
  orgRoleId String?
  orgRole   OrgRole? @relation(fields: [orgRoleId], references: [id], onDelete: SetNull)

  accounts     Account[]
  sessions     Session[]
  testSessions TestSession[]
  results      TestResult[]

  @@index([role])
  @@map("users")
}

/// Account OAuth collegati (Google). Richiesto dall'adapter Auth.js.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Presente per compatibilità con l'adapter Auth.js (la strategia attiva è JWT).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===========================================================================
// MODULO 3 — Temi di talento, domande, risposte e risultati
// ===========================================================================

/// Le 4 macro-aree del modello Gallup CliftonStrengths.
enum Domain {
  EXECUTING // Esecuzione
  INFLUENCING // Influenza
  RELATIONSHIP // Relazioni
  STRATEGIC // Pensiero Strategico
}

model TalentTheme {
  id     String @id @default(cuid())
  /// Identificatore stabile usato dal motore di calcolo (es. "realizzatore").
  slug   String @unique
  name   String
  domain Domain

  /// Claim di una riga mostrato nelle card della Top 5.
  tagline            String
  /// Descrizione approfondita del tema (2-4 paragrafi).
  fullDescription    String   @db.Text
  /// Come suona il tema quando lavora al meglio.
  strengths          String[]
  /// Punti ciechi: il lato ombra del talento quando è sovra-utilizzato.
  blindSpots         String[]
  /// Azioni concrete per allenare il tema.
  actionTips         String[]
  /// Professioni / contesti in cui il tema rende di più.
  thrivesIn          String[]
  /// Come il tema si esprime quando la persona guida (lente LEADERS).
  leaderApplication  String   @default("") @db.Text
  /// Come far rendere al meglio chi ha questo tema (lente MANAGERS).
  managerApplication String   @default("") @db.Text

  leftInQuestions  Question[]   @relation("LeftTheme")
  rightInQuestions Question[]   @relation("RightTheme")
  themeScores      ThemeScore[]

  @@index([domain])
  @@map("talent_themes")
}

// ===========================================================================
// MODULO 2 — Assessment e questionari
// ===========================================================================

/// Come sono fatti gli item di un assessment. I due formati convivono: i
/// questionari storici restano a coppie di affermazioni su scala, quelli della
/// Mappa dei Punti di Forza usano blocchi a scelta forzata.
enum ItemFormat {
  /// Due affermazioni contrapposte e una scala a 7 punti.
  PAIRED_LIKERT
  /// Quattro affermazioni fra cui indicare quella che descrive di più e quella
  /// che descrive di meno.
  FORCED_CHOICE_QUARTET
}

/// Lente di lettura del report prodotto da un assessment.
enum ReportLens {
  /// Top 5 e classifica completa dei temi somministrati.
  STANDARD
  /// Tutti i 34 temi ordinati, con la Top 10 in evidenza.
  FULL_34
  /// Come i talenti si esprimono nel ruolo di chi guida.
  LEADERS
  /// Come i talenti si esprimono nella gestione quotidiana di un team.
  MANAGERS
  /// Classifica completa dei tratti, con una fascia dominante più ampia.
  /// Equivalente di FULL_34 per la tassonomia della Mappa dei Punti di Forza,
  /// che non ha 34 elementi.
  FULL_RANKING
}

/// Un questionario somministrabile. Ogni assessment ha la propria banca di
/// item e la propria lente di report.
model Assessment {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  subtitle    String
  description String @db.Text

  lens       ReportLens @default(STANDARD)
  itemFormat ItemFormat @default(PAIRED_LIKERT)

  /// Quanti temi dominanti evidenziare nel report.
  topCount         Int @default(5)
  /// Secondi per item; 0 disattiva il timer.
  timerSeconds     Int @default(20)
  /// Minuti stimati di compilazione, mostrati prima di iniziare.
  estimatedMinutes Int

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  questions    Question[]
  blocks       ChoiceBlock[]
  testSessions TestSession[]
  results      TestResult[]
  orgRoles     OrgRoleAssessment[]

  @@index([isActive, sortOrder])
  @@map("assessments")
}

// ===========================================================================
// Item del questionario
// ===========================================================================

model Question {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Ordine di somministrazione dentro il proprio assessment (1..N).
  position Int

  leftStatement  String @db.Text
  rightStatement String @db.Text

  leftThemeId  String
  rightThemeId String
  leftTheme    TalentTheme @relation("LeftTheme", fields: [leftThemeId], references: [id])
  rightTheme   TalentTheme @relation("RightTheme", fields: [rightThemeId], references: [id])

  /// Peso del contributo dell'item al tema di sinistra / destra (0..1].
  leftWeight  Float @default(1)
  rightWeight Float @default(1)

  /// Permette di ritirare un item senza perdere lo storico delle risposte.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses Response[]

  @@unique([assessmentId, position])
  @@index([assessmentId, isActive, position])
  @@map("questions")
}

// ===========================================================================
// MAPPA DEI PUNTI DI FORZA — tassonomia proprietaria e item a scelta forzata
// ===========================================================================
//
// Modelli separati da TalentTheme, non un suo ampliamento: le due tassonomie
// hanno architetture diverse (5 aree per 30 tratti contro 4 domini per 34 temi)
// e ciclo di vita indipendente. Tenerle distinte evita che una modifica al
// nuovo modello tocchi i questionari già somministrati e i loro report.

/// Una delle macro-aree del modello (Direzione, Energia, Regolazione,
/// Relazione, Apertura). A differenza dei domini legacy non è un enum: le aree
/// sono dati, e possono essere riviste senza migrare lo schema.
model StrengthArea {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  /// Sigla di tre lettere usata dove lo spazio è poco (grafici, PDF).
  short String

  /// Colore in esadecimale che identifica l'area nei grafici.
  color     String
  sortOrder Int    @default(0)

  /// Frase che riassume l'area in una riga.
  claim       String
  description String @db.Text
  /// Costrutti pubblici della letteratura a cui l'area si àncora.
  grounding   String @db.Text

  traits StrengthTrait[]
  scores AreaScore[]

  @@index([sortOrder])
  @@map("strength_areas")
}

/// Uno dei tratti misurati dalla Mappa dei Punti di Forza.
model StrengthTrait {
  id     String       @id @default(cuid())
  slug   String       @unique
  name   String
  areaId String
  area   StrengthArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  tagline    String
  definition String @db.Text

  /// Come si manifesta il tratto quando è al lavoro.
  strengths  String[]
  /// Il rovescio: che cosa succede quando è usato oltre misura.
  blindSpots String[]
  /// Indicazioni concrete per allenarlo.
  actionTips String[]
  /// Contesti in cui rende di più.
  thrivesIn  String[]

  /// Come il tratto si esprime in chi guida (lente LEADERS).
  leaderApplication  String @db.Text
  /// Come far rendere chi lo possiede (lente MANAGERS).
  managerApplication String @db.Text

  options ChoiceOption[]
  scores  TraitScore[]

  @@index([areaId])
  @@map("strength_traits")
}

/// Un blocco quartetto: quattro affermazioni fra cui scegliere.
model ChoiceBlock {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Ordine di somministrazione dentro il proprio assessment (1..N).
  position Int

  /// Se valorizzato, il blocco ripropone i tratti del blocco indicato con altre
  /// parole: serve solo a misurare la coerenza ed è escluso dai punteggi.
  controlForPosition Int?

  /// Permette di ritirare un blocco senza perdere lo storico delle risposte.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options   ChoiceOption[]
  responses BlockResponse[]

  @@unique([assessmentId, position])
  @@index([assessmentId, isActive, position])
  @@map("choice_blocks")
}

/// Una delle quattro affermazioni di un blocco.
model ChoiceOption {
  id      String      @id @default(cuid())
  blockId String
  block   ChoiceBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  /// Posizione dell'affermazione dentro il blocco (1..4).
  position Int

  traitId String
  trait   StrengthTrait @relation(fields: [traitId], references: [id])

  statement String @db.Text

  chosenAsMost  BlockResponse[] @relation("MostChoice")
  chosenAsLeast BlockResponse[] @relation("LeastChoice")

  @@unique([blockId, position])
  @@index([traitId])
  @@map("choice_options")
}

/// Risposta a un blocco quartetto.
model BlockResponse {
  id            String @id @default(cuid())
  testSessionId String
  blockId       String

  /// Affermazione indicata come "mi descrive di più" / "di meno". Null quando
  /// il blocco è stato saltato allo scadere del tempo: la scelta forzata non
  /// ammette una via di mezzo, quindi un blocco senza risposta resta vuoto
  /// invece di essere riempito con un valore neutro inesistente.
  mostOptionId  String?
  leastOptionId String?

  /// true se il blocco è stato chiuso dallo scadere del timer.
  timedOut  Boolean @default(false)
  /// Tempo di reazione in millisecondi.
  latencyMs Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testSession TestSession   @relation(fields: [testSessionId], references: [id], onDelete: Cascade)
  block       ChoiceBlock   @relation(fields: [blockId], references: [id], onDelete: Cascade)
  mostOption  ChoiceOption? @relation("MostChoice", fields: [mostOptionId], references: [id], onDelete: SetNull)
  leastOption ChoiceOption? @relation("LeastChoice", fields: [leastOptionId], references: [id], onDelete: SetNull)

  @@unique([testSessionId, blockId])
  @@index([blockId])
  @@map("block_responses")
}

enum TestStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

/// Una compilazione del questionario. Consente di riprendere da dove si era rimasti.
model TestSession {
  id           String     @id @default(cuid())
  userId       String
  assessmentId String
  status       TestStatus @default(IN_PROGRESS)

  /// Numero di item già risposti: indice di ripresa del questionario.
  answeredCount  Int @default(0)
  /// Totale item attivi al momento dell'avvio (congelato per coerenza).
  totalQuestions Int
  /// Secondi a disposizione per item; 0 = timer disattivato.
  timerSeconds   Int @default(20)

  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @updatedAt
  completedAt    DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment     Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  responses      Response[]
  blockResponses BlockResponse[]
  result         TestResult?

  @@index([userId, assessmentId, status])
  @@map("test_sessions")
}

model Response {
  id            String @id @default(cuid())
  testSessionId String
  questionId    String

  /// Scala Likert a 7 punti: 1 = pienamente l'affermazione di sinistra,
  /// 4 = neutro, 7 = pienamente l'affermazione di destra.
  value Int

  /// true se il valore è stato salvato come "neutro" per scadenza del timer.
  timedOut  Boolean @default(false)
  /// Tempo di reazione in millisecondi (metrica di istintività).
  latencyMs Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testSession TestSession @relation(fields: [testSessionId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testSessionId, questionId])
  @@index([questionId])
  @@map("responses")
}

// ===========================================================================
// MODULO 4 — Risultati e report
// ===========================================================================

model TestResult {
  id            String @id @default(cuid())
  testSessionId String @unique
  userId        String
  assessmentId  String

  /// Punteggi 0-100 delle 4 macro-aree del modello legacy (somma 100).
  /// Nulli per i risultati della Mappa dei Punti di Forza, che ha cinque aree
  /// e le conserva in `areaScores`.
  executingScore    Float?
  influencingScore  Float?
  relationshipScore Float?
  strategicScore    Float?

  /// Slug degli elementi dominanti in ordine di punteggio decrescente: temi per
  /// i questionari legacy, tratti per quelli della Mappa dei Punti di Forza.
  /// Quale delle due tassonomie leggere lo dice `assessment.itemFormat`.
  topThemeSlugs String[]

  /// Quota di risposte scadute per timeout: indicatore di affidabilità.
  timeoutRatio    Float @default(0)
  /// Durata complessiva della compilazione, in secondi.
  durationSeconds Int?

  /// Quota di scelte non confermate nei blocchi di controllo (solo scelta
  /// forzata). Si legge fra 0,5 — chi risponde con attenzione — e 0,75, che è
  /// il livello di chi risponde a caso.
  inconsistencyRate Float?
  /// Indice di attendibilità 0-100 che tiene insieme coerenza e completezza.
  reliabilityIndex  Int?
  /// Lettura sintetica della coerenza: buona / da_verificare / bassa.
  /// I sedici confronti di controllo bastano a collocare una compilazione in
  /// una fascia, non a rendere preciso il numero puntuale.
  reliabilityBand   String?

  computedAt DateTime @default(now())

  testSession TestSession     @relation(fields: [testSessionId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment  Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  themeScores ThemeScore[]
  areaScores  AreaScore[]
  traitScores TraitScore[]
  downloads   AdminAuditLog[]

  @@index([userId, computedAt])
  @@index([assessmentId, computedAt])
  @@map("test_results")
}

/// Punteggio per singolo tema, denormalizzato per query analitiche veloci.
model ThemeScore {
  id           String @id @default(cuid())
  testResultId String
  themeId      String

  /// Punteggio grezzo 0-100 (media ponderata delle risposte sull'item).
  rawScore        Float
  /// Punteggio normalizzato intra-individuo (z-score ipsativo riscalato 0-100).
  normalizedScore Float
  /// Posizione in classifica: 1 = talento dominante.
  rank            Int

  testResult TestResult  @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  theme      TalentTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([testResultId, themeId])
  @@index([themeId, normalizedScore])
  @@map("theme_scores")
}

/// Punteggio per macro-area della Mappa dei Punti di Forza. È una tabella e non
/// quattro colonne come nel modello legacy: il numero di aree è un dato del
/// modello, e cambiarlo non deve richiedere una migrazione dello schema.
model AreaScore {
  id           String @id @default(cuid())
  testResultId String
  areaId       String

  /// Quota dell'area sul totale, in percentuale (le aree sommano a 100).
  score Float

  testResult TestResult   @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  area       StrengthArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([testResultId, areaId])
  @@map("area_scores")
}

/// Punteggio per singolo tratto, denormalizzato per query analitiche veloci.
model TraitScore {
  id           String @id @default(cuid())
  testResultId String
  traitId      String

  /// Media delle quote di preferenza ricevute nei blocchi, 0-100.
  rawScore        Float
  /// Punteggio normalizzato entro persona (z-score ipsativo riscalato 0-100).
  normalizedScore Float
  /// Posizione in classifica: 1 = tratto dominante.
  rank            Int

  /// Quante volte il tratto è stato indicato come "mi descrive di più" e come
  /// "di meno": due numeri concreti che rendono leggibile il punteggio.
  timesMost  Int @default(0)
  timesLeast Int @default(0)

  testResult TestResult    @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  trait      StrengthTrait @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@unique([testResultId, traitId])
  @@index([traitId, normalizedScore])
  @@map("trait_scores")
}

// ===========================================================================
// Tracciabilità delle azioni amministrative su dati personali
// ===========================================================================

enum AdminAction {
  REPORT_DOWNLOAD
  RESULTS_EXPORT
  USER_CREATED
  ROLE_CHANGED
  BRANDING_UPDATED
  ORG_ROLE_UPDATED
  ORG_ROLE_ASSIGNED
}

/// Un report descrive preferenze e stile di lavoro di una persona: ogni accesso
/// da parte di un amministratore viene registrato, così l'interessato può
/// sapere chi ha visto cosa.
model AdminAuditLog {
  id           String      @id @default(cuid())
  action       AdminAction
  /// Amministratore che ha compiuto l'azione.
  actorId      String
  actorEmail   String
  /// Utente a cui si riferiscono i dati toccati, quando applicabile.
  subjectId    String?
  subjectEmail String?
  /// Report scaricato, quando l'azione è un download.
  testResultId String?
  /// Dettaglio leggibile dell'azione.
  detail       String?

  createdAt DateTime @default(now())

  testResult TestResult? @relation(fields: [testResultId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([subjectId])
  @@map("admin_audit_logs")
}

// ===========================================================================
// Personalizzazione (logo, nome, colore) applicata al sito e ai report
// ===========================================================================

/// Riga unica di configurazione: `id` è fissato a "singleton" così non possono
/// esistere due configurazioni in conflitto.
model AppSettings {
  id String @id @default("singleton")

  /// Nome mostrato nell'intestazione, nel titolo delle pagine e nel PDF.
  organizationName String @default("Portale Talenti")

  /// Logo caricato dall'amministratore, conservato nel database: niente
  /// dipendenze da filesystem o storage esterni, e il backup del database
  /// porta con sé anche il logo.
  logoData      Bytes?
  logoMimeType  String?
  logoUpdatedAt DateTime?

  /// Colore principale in formato esadecimale: da questo si genera l'intera
  /// scala di tinte usata dall'interfaccia.
  primaryColor String @default("#164ede")

  /// Riga libera in fondo a ogni pagina del PDF (es. ragione sociale).
  reportFooter String?

  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ===========================================================================
// Ruoli organizzativi: chi vede quali questionari
// ===========================================================================

/// Un ruolo aziendale (Collaboratore, Manager, Leader…). Determina l'insieme
/// di questionari somministrati alle persone che lo ricoprono.
model OrgRole {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String

  /// Ruolo applicato a chi non ne ha uno assegnato esplicitamente.
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)

  users       User[]
  assessments OrgRoleAssessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("org_roles")
}

/// Abilitazione di un questionario per un ruolo, con la distinzione fra
/// "può farlo" e "deve farlo".
model OrgRoleAssessment {
  orgRoleId    String
  assessmentId String

  /// true = richiesto alla persona; false = disponibile ma facoltativo.
  isRequired Boolean @default(false)

  orgRole    OrgRole    @relation(fields: [orgRoleId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@id([orgRoleId, assessmentId])
  @@index([assessmentId])
  @@map("org_role_assessments")
}
